  "private": true,
  "description": "Learn SQL in the browser: real SQLite, Bengali explanations and a step-by-step query visualizer.",
  "license": "MIT",
  "author": "msilabs",
  "homepage": "https://msilabs.github.io/sql-playground/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msilabs/sql-playground.git"
  },
  "bugs": {
    "url": "https://github.com/msilabs/sql-playground/issues"
  },
  "keywords": [
    "sql",
