    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"SQL Playground","url":"https://msilabs.github.io/sql-playground/","description":"ব্রাউজারেই আসল SQLite দিয়ে SQL শিখুন। বাংলা ব্যাখ্যা, ধাপে ধাপে query, আলাদা আলাদা পাঠ আর challenge।","applicationCategory":"EducationalApplication","operatingSystem":"Any","inLanguage":"bn","isAccessibleForFree":true,"teaches":"SQL","offers":{"@type":"Offer","price":"0","priceCurrency":"BDT"},"author":{"@type":"Organization","name":"msilabs","url":"https://msilabs.github.io/"},"license":"https://opensource.org/licenses/MIT","codeRepository":"https://github.com/msilabs/sql-playground"}</script>
